{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/proof/:path*",
      "destination": "https://proof-server.preprod.midnight.network/:path*"
    },
    {
      "source": "/api/indexer",
      "destination": "https://indexer.preprod.midnight.network/api/v4/graphql"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
